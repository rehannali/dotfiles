{{- if and (eq .chezmoi.os "darwin") (ne ((index . "profile") | default "full") "cli") -}}
#!/usr/bin/env bash
# fastlane and CocoaPods live in mise's Ruby ({{ .packages.runtimes.ruby }}), not in Homebrew's.
# Re-runs when the gem list or the Ruby version changes (both are part of this rendered text).
set -euo pipefail

DEST_DIR="{{ .chezmoi.destDir }}"
[[ -f "$DEST_DIR/.local/lib/chezmoi-utils.sh" ]] && . "$DEST_DIR/.local/lib/chezmoi-utils.sh"

continue_on_failure "Ruby gems"

command -v mise > /dev/null 2>&1 || bail "mise not found; run_onchange_after_12-install-mise-tools should have installed it."

info "Installing gems into mise's Ruby {{ .packages.runtimes.ruby }}"
# one gem at a time: one that cannot be fetched must not keep the others out
failed=""
for gem in{{ range .packages.darwin.gems }} {{ . }}{{ end }}; do
  retry run mise exec ruby@{{ .packages.runtimes.ruby }} -- gem install --no-document "$gem" || failed="$failed $gem"
done
run mise reshim || true
[ -z "$failed" ] || error "Gems NOT installed (see above):$failed"
{{ end -}}
