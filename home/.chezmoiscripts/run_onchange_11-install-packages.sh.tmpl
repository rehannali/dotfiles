{{- if eq .chezmoi.os "darwin" -}}
{{- $plan := includeTemplate "tool-plan" . | fromJson -}}
{{- $appleSilicon := eq .chezmoi.arch "arm64" -}}
{{- $profile := (index . "profile") | default "full" -}}
{{- /* where casks with an appdir go (settings.macos.cask_appdir, "~/Applications" unless set) */ -}}
{{- $appdir := dig "settings" "macos" "cask_appdir" "~/Applications" . -}}
#!/usr/bin/env bash
# Homebrew packages for macOS/{{ .chezmoi.arch }}. What brew installs here is decided by home/.chezmoitemplates/tool-plan.
# Written for macOS's stock bash 3.2: no empty-array expansion under `set -u`, no heredocs inside $(...).
set -euo pipefail

DEST_DIR="{{ .chezmoi.destDir }}"
[[ -f "$DEST_DIR/.local/lib/chezmoi-utils.sh" ]] && . "$DEST_DIR/.local/lib/chezmoi-utils.sh"

{{ if $appleSilicon -}}
info "chezmoi: Apple Silicon - CLI tools, system packages{{ if ne $profile "cli" }}, casks and App Store apps{{ end }} via Homebrew"
{{- else -}}
info "chezmoi: Intel Mac - casks and App Store apps via Homebrew; formulae only when a bottle exists (CLI tools come from mise)"
{{- end }}

{{ if not $appleSilicon -}}
# Intel: brew needs some directories of /usr/local (lib/pkgconfig, share/man/man8, ...) to belong to you, and on a Mac that
# had /usr/local before Homebrew they belong to root. bootstrap.sh fixes that; this asks Homebrew itself which ones
# are still wrong, so it also holds when only `chezmoi apply` runs.
unwritable="$(brew ruby -e 'puts Keg.must_be_writable_directories.select { |d| d.exist? && !d.writable? }' 2> /dev/null < /dev/null || true)"
if [ -n "$unwritable" ]; then
  info "Homebrew directories that are not writable by $(id -un), taking them over:"
  while IFS= read -r dir; do
    [ -n "$dir" ] || continue
    info "  $dir"
    if sudo chown "$(id -un):admin" "$dir"; then
      sudo chmod u+rwx,g+rwx "$dir" || true
    else
      error "Could not take over $dir: run  sudo chown $(id -un):admin $dir  (brew warns about it otherwise)."
    fi
  done <<< "$unwritable"
fi
{{ end -}}
{{ if ne $profile "cli" -}}
# casks with an appdir put their app there; make sure the directory exists
mkdir -p "{{ $appdir | replace "~" "$HOME" }}"

{{ end -}}
# Refresh the formula index on purpose. Never `brew upgrade`: on Intel (Tier 3) it can compile from source.
run brew update || error "brew update failed; continuing with the cached formula index."

BREWFILE="$(mktemp)"
trap 'rm -f "$BREWFILE"' EXIT
cat > "$BREWFILE" <<'BrewfileEOF'
{{ if $appleSilicon -}}
{{- range $plan.brew }}
brew {{ .name | quote }}{{ if .args }}, {{ .args }}{{ end }}
{{- end }}
{{ end -}}
{{- if ne $profile "cli" -}}
{{- range .packages.darwin.casks }}
cask {{ .name | quote }}{{ if hasKey . "args_str" }}, {{ .args_str | replace "~/Applications" $appdir }}{{ end }}
{{- end }}
{{ range .packages.darwin.mas -}}
mas {{ .name | quote }}, id: {{ .id }}
{{ end -}}
{{- if $appleSilicon -}}
{{- range .packages.darwin_arm.casks }}
cask {{ .name | quote }}{{ if hasKey . "args_str" }}, {{ .args_str | replace "~/Applications" $appdir }}{{ end }}
{{- end }}
{{ end -}}
{{- end -}}
BrewfileEOF

# Can this Mac install what the Brewfile asks for?
# Taps disappear, casks get disabled upstream, move to another tap, drop Intel or raise the minimum macOS; formulae get
# disabled. brew bundle fails on those and would abort the whole apply, so ask Homebrew first, report, and
# leave out what cannot work. Needs python3 (the Xcode Command Line Tools provide it); without it nothing
# is filtered.
#   DOTFILES_CASKS=install (default) | check (report only, install no casks) | skip
#   DOTFILES_MAS=install (default) | skip      (App Store apps need a signed-in App Store)
cask_mode="${DOTFILES_CASKS:-install}"
mas_mode="${DOTFILES_MAS:-install}"
CHECKER="$(mktemp)"
trap 'rm -f "$BREWFILE" "$CHECKER"' EXIT
cat > "$CHECKER" <<'PYEOF'
import json, sys
kind, tok, major, arch = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4]
NAMES = {"big_sur": 11, "monterey": 12, "ventura": 13, "sonoma": 14, "sequoia": 15, "tahoe": 26}
item = json.load(sys.stdin)["casks" if kind == "cask" else "formulae"][0]
if item.get("disabled"):
    print("%s :: disabled upstream (%s)" % (tok, item.get("disable_date") or "no date"))
    sys.exit()
dep = item.get("depends_on") or {}
for a in dep.get("arch") or []:
    a = a if isinstance(a, str) else (a.get("type") or a.get("arch") or "")
    if a in ("arm64", "intel", "x86_64") and ("arm64" if a == "arm64" else "x86_64") != arch:
        print("%s :: only supports %s, this Mac is %s" % (tok, a, arch))
        sys.exit()
for op, vals in (dep.get("macos") or {}).items():
    for v in vals:
        n = NAMES.get(str(v).lstrip(":"))
        if n is None:
            try:
                n = int(str(v).split(".")[0])
            except ValueError:
                continue
        if op == ">=" and major < n:
            print("%s :: needs macOS %s or newer, this is macOS %s" % (tok, n, major))
            sys.exit()
PYEOF

unsupported=" "
report=""

# Taps first: one that cannot be cloned (repository gone or private) fails the whole bundle. Homebrew 6 and newer
# also load nothing from a tap that is not trusted (https://docs.brew.sh/Tap-Trust), and `brew info` below, `brew deps`
# and `brew bundle` all fail on it. So each tap is cloned, then exactly the formulae and casks used from it are
# trusted (never the whole tap), and only then does it go into the Brewfile, with the same list as `trusted:` so
# `brew bundle` trusts them again by itself. Entry format: tap|formulae|casks (space separated lists).
ruby_list() { local out="" x; for x in "$@"; do out="$out${out:+, }\"$x\""; done; printf '[%s]' "$out"; }
taplines=""
for entry in {{ range .packages.taps }}{{ printf "%s|%s|%s" .name (join " " (concat (get . "formulae" | default (list)) (get . "needs" | default (list)))) (join " " (get . "casks" | default (list))) | quote }} {{ end }}; do
  tap="${entry%%|*}"
  rest="${entry#*|}"
  formulae="${rest%%|*}"
  casks="${rest#*|}"
  if ! brew tap "$tap" > /dev/null 2>&1 < /dev/null; then
    unsupported="$unsupported$tap "
    report="$report
  - tap $tap: cannot be cloned (repository gone or private)"
    continue
  fi
  trust_failed=""
  # shellcheck disable=SC2086  # the lists are space separated words
  for item in $formulae; do brew_trust --formula "$tap/$item" || trust_failed="$trust_failed $tap/$item"; done
  # shellcheck disable=SC2086
  for item in $casks; do brew_trust --cask "$tap/$item" || trust_failed="$trust_failed $tap/$item"; done
  if [ -n "$trust_failed" ]; then
    unsupported="$unsupported$tap$trust_failed "
    report="$report
  - tap $tap: could not trust$trust_failed (is the name right? see https://docs.brew.sh/Tap-Trust)"
    continue
  fi
  hash=""
  if brew_has_trust; then
    # shellcheck disable=SC2086
    [ -z "$formulae" ] || hash="formulae: $(ruby_list $formulae)"
    # shellcheck disable=SC2086
    [ -z "$casks" ] || hash="$hash${hash:+, }casks: $(ruby_list $casks)"
  fi
  if [ -n "$hash" ]; then taplines="$taplines
tap \"$tap\", trusted: { $hash }"; else taplines="$taplines
tap \"$tap\""; fi
done
{ printf '%s\n' "${taplines#?}"; cat "$BREWFILE"; } > "$BREWFILE.new" && mv "$BREWFILE.new" "$BREWFILE"
if brew_has_trust; then
  # tap-qualified entries also trust themselves (docs.brew.sh/Brew-Bundle-and-Brewfile, "trusted")
  sed -E 's#^((brew|cask) "[^"/]+/[^"/]+/[^"/]+")#\1, trusted: true#' "$BREWFILE" > "$BREWFILE.new" && mv "$BREWFILE.new" "$BREWFILE"
  info "Trusted taps, formulae and casks:"
  brew trust < /dev/null 2>&1 || true
fi

# A cask that is in the Brewfile but still not installed after the bundle: one failing cask (a tap that was not trusted, an
# installer that stopped) must not take the others with it, and `brew bundle` can skip the rest of a batch. So every cask
# that is missing is installed once more on its own, with its appdir. (`brew install --cask tap/repo/name` also trusts
# exactly that cask by itself, docs.brew.sh/Tap-Trust.)
retry_missing_casks() {
  local full dir
  while IFS='|' read -r full dir; do
    [ -n "$full" ] || continue
    brew list --cask "${full##*/}" > /dev/null 2>&1 < /dev/null && continue
    dir="${dir/#\~/$HOME}"
    info "$full is not installed after the bundle, installing it on its own${dir:+ (appdir $dir)}"
    if [ -n "$dir" ]; then
      run brew install --cask "--appdir=$dir" "$full" || error "$full could not be installed."
    else
      run brew install --cask "$full" || error "$full could not be installed."
    fi
  done < <(awk '$1=="cask" { name=$2; gsub(/[",]/,"",name); dir=""
                 if (match($0, /appdir: *"[^"]*"/)) { dir=substr($0, RSTART, RLENGTH); sub(/^appdir: *"/,"",dir); sub(/"$/,"",dir) }
                 print name "|" dir }' "$BREWFILE")
}

if command -v python3 > /dev/null 2>&1; then
  major="$(sw_vers -productVersion | cut -d. -f1)"
  machine="$(uname -m)"
  kinds="{{ if $appleSilicon }}formula {{ end }}cask"
  for kind in $kinds; do
    if [ "$kind" = cask ] && [ "$cask_mode" = skip ]; then continue; fi
    keyword="$kind"; if [ "$kind" = formula ]; then keyword=brew; fi
    while read -r tok; do
      short="${tok##*/}"
      if [ "$kind" = formula ] && [ "$short" != "$tok" ] && ! brew list --formula "$tok" > /dev/null 2>&1 < /dev/null \
          && brew list --formula "$short" > /dev/null 2>&1 < /dev/null; then
        # e.g. a runner or an old install has core's xcodes; the tap's xcodes cannot be installed next to it
        why="$tok :: a formula named $short from another tap is already installed"
      elif json="$(brew info --json=v2 "--$kind" "$tok" 2> /dev/null < /dev/null)"; then
        why="$(printf '%s' "$json" | python3 "$CHECKER" "$kind" "$tok" "$major" "$machine")" || why=""
      else
        why="$tok :: not found in any tap"
      fi
      if [ -n "$why" ]; then
        unsupported="$unsupported$tok "
        report="$report
  - $kind ${why%% :: *}: ${why#* :: }"
      fi
    done < <(awk -v k="$keyword" '$1==k {gsub(/[",]/,"",$2); print $2}' "$BREWFILE")
  done
fi
if [ -n "$report" ]; then
  error "Not installable on this Mac, left out of the Brewfile:$report"
  if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
    # shellcheck disable=SC2016  # the backticks are Markdown, not a command substitution
    printf '### Left out by the Homebrew support check\n```%s\n```\n' "$report" >> "$GITHUB_STEP_SUMMARY"
  fi
  awk -v skip="$unsupported" '$1=="cask" || $1=="brew" || $1=="tap" { t=$2; gsub(/[",]/,"",t); if (index(skip, " " t " ")) next } { print }' \
    "$BREWFILE" > "$BREWFILE.new" && mv "$BREWFILE.new" "$BREWFILE"
else
  info "Support check: everything in the Brewfile can be installed on this Mac."
fi
if [ "$cask_mode" != install ]; then
  info "DOTFILES_CASKS=$cask_mode: no casks are installed in this run."
  awk '$1!="cask"' "$BREWFILE" > "$BREWFILE.new" && mv "$BREWFILE.new" "$BREWFILE"
fi
# DOTFILES_SKIP_CASKS="netbird-ui other-cask": leave single casks out of this run (space separated, short names). For one
# that does not suit this machine, or one whose installer needs something a CI runner cannot give (netbird-ui starts a
# system service with sudo and stalls there).
for skip_cask in ${DOTFILES_SKIP_CASKS:-}; do
  info "DOTFILES_SKIP_CASKS: not installing the cask $skip_cask in this run."
  awk -v c="$skip_cask" '{ t=$2; gsub(/[",]/,"",t); if ($1=="cask" && (t==c || t ~ ("/" c "$"))) next; print }' \
    "$BREWFILE" > "$BREWFILE.new" && mv "$BREWFILE.new" "$BREWFILE"
done
if [ "$mas_mode" = skip ]; then
  info "DOTFILES_MAS=skip: no App Store apps are installed in this run."
  awk '$1!="mas"' "$BREWFILE" > "$BREWFILE.new" && mv "$BREWFILE.new" "$BREWFILE"
fi

{{ if $appleSilicon -}}
bundle_status=0
run brew bundle -v --no-upgrade --file="$BREWFILE" || bundle_status=$?
retry_missing_casks
if [ "$bundle_status" -ne 0 ]; then
  # not fatal: one cask that fails must not stop chezmoi from running the scripts after this one (mise tools, gems,
  # Flutter, shell). Run `brew bundle` again, or install the cask by hand, once the cause is fixed.
  error "brew bundle exited with status $bundle_status: some casks / apps / formulae were NOT installed (see above). The rest of the setup continues."
fi
{{- else -}}
# Intel: casks and App Store apps through the bundle
bundle_status=0
run brew bundle -v --no-upgrade --file="$BREWFILE" || bundle_status=$?
retry_missing_casks

# Intel: formulae, bottle-only
# Homebrew builds no new Intel bottles (Tier 3). `brew install --force-bottle` refuses to compile the
# formula itself, but its dependencies are installed with force_bottle=false and WOULD be compiled.
# So the formula and every runtime dependency that is not installed yet must have a bottle first.
major="$(sw_vers -productVersion | cut -d. -f1)"
tags=""
for entry in tahoe:26 sequoia:15 sonoma:14 ventura:13 monterey:12 big_sur:11; do
  if [ "$major" -ge "${entry#*:}" ]; then tags="$tags ${entry%%:*}"; fi   # bottles for older macOS are usable
done
# shellcheck disable=SC2086  # $tags is a space-separated word list
tag_re="\"(all$(printf '|%s' $tags))\":[[:space:]]*\\{"

has_intel_bottle() {
  local json
  json="$(brew info --json=v2 --formula "$1" 2>/dev/null)" || return 1
  grep -Eq "$tag_re" <<< "$json"   # herestring, not a pipe: grep -q + pipefail would report SIGPIPE
}

# Print the formulae in $1 + its runtime dependencies that are not installed and have no usable bottle.
# $2 = true skips $1 itself (tap formula that downloads a prebuilt binary).
unbottled() {
  local dep missing=""
  for dep in $([ "$2" = true ] || echo "$1") $(brew deps --formula "$1" 2>/dev/null); do
    brew list --formula "$dep" > /dev/null 2>&1 && continue
    has_intel_bottle "$dep" || missing="$missing $dep"
  done
  echo "$missing"
}

installed=""
built=""
skipped=""
failed=""
# MacPorts is the fallback for a formula Homebrew has no bottle for (a `port` in packages.yml), so nothing is compiled.
#   DOTFILES_MACPORTS=install (default) | skip
macports_mode="${DOTFILES_MACPORTS:-install}"
ported=""
port_failed=""
port_wanted=""
for entry in {{ range $plan.brew }}{{ printf "%s|%t|%t|%s" .name .prebuilt .source .port | quote }} {{ end }}; do
  IFS='|' read -r formula prebuilt source_ok port <<< "$entry"   # herestring, not a pipe: the loop's variables must survive
  if brew list --formula "$formula" > /dev/null 2>&1; then continue; fi   # installed: leave it alone
  if [ -n "$port" ] && [ -x /opt/local/bin/port ]; then
    port_state="$(/opt/local/bin/port installed "$port" 2> /dev/null || true)"
    if [[ "$port_state" == *"(active)"* ]]; then continue; fi   # installed from MacPorts on an earlier run
  fi

  # source_ok: mise has no Intel build of this tool (mise_intel: false), so Homebrew is the only way to get
  # it and it is installed even when that means compiling (slow, 2 jobs); everything else is bottle-only.
  missing="$(unbottled "$formula" "$prebuilt")"
  if [ -n "${missing# }" ] && [ -n "$port" ] && [ "$macports_mode" = install ]; then
    # no usable Homebrew bottle (also for tools that would otherwise compile from source): a MacPorts binary instead
    info "$formula has no Intel bottle (missing:$missing): using MacPorts port $port"
    port_wanted="$port_wanted $port"
    continue
  fi
  if [ "$source_ok" = true ]; then
    if [ -n "${missing# }" ]; then
      info "$formula has no Intel bottle (missing:$missing): building from source, this takes a while"
      built="$built $formula"
    fi
    if run brew install --formula "$formula"; then installed="$installed $formula"; else failed="$failed $formula"; fi
    continue
  fi
  if [ -n "${missing# }" ]; then
    skipped="$skipped
  - $formula  (no Intel bottle:$missing)"
    continue
  fi

  if [ "$prebuilt" = true ]; then
    if run brew install --formula "$formula"; then installed="$installed $formula"; else failed="$failed $formula"; fi
  else
    if run brew install --force-bottle --formula "$formula"; then installed="$installed $formula"; else failed="$failed $formula"; fi
  fi
done

# MacPorts: binary archives only (-b), one port at a time so one that has none does not stop the others
if [ -n "${port_wanted# }" ]; then
  if ensure_macports; then
    for port in $port_wanted; do
      if run sudo /opt/local/bin/port -N -b install "$port"; then ported="$ported $port"; else port_failed="$port_failed $port"; fi
    done
  else
    skipped="$skipped
  - $port_wanted  (MacPorts could not be installed, see above)"
  fi
fi

[ -z "$ported" ] || info "Installed from MacPorts:$ported"
if [ -n "$port_failed" ]; then
  # most often "Failed to archivefetch ...: 404": MacPorts has not built a binary of that port for this macOS yet
  error "Not installed from MacPorts (no binary archive for this macOS, or the install failed, see above):$port_failed"
  info "Nothing was compiled. Try again later, use what macOS ships, or build on purpose:  sudo port install <port>"
fi
[ -z "$installed" ] || info "Installed:$installed"
[ -z "$built" ] || info "Built from source (no Intel bottle):$built"
if [ -n "$skipped" ]; then
  error "Skipped - Homebrew has no Intel bottle for these (or for one of their dependencies):$skipped"
  info "Nothing was compiled. Use the tool macOS already ships, or build one on purpose:"
  info "  brew install --build-from-source <formula>   (slow; Intel is Tier 3)"
fi
[ -z "$failed" ] || error "brew install failed for:$failed"

if [ "$bundle_status" -ne 0 ]; then
  error "brew bundle (casks / App Store) exited with status $bundle_status: some were NOT installed (see above). The rest of the setup continues."
fi
{{- end }}

info "Brew cleanup"
run brew cleanup
{{ end -}}
