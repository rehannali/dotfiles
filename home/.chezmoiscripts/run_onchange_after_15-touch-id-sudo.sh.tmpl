{{- if and (eq .chezmoi.os "darwin") .settings.macos.touch_id_sudo -}}
#!/usr/bin/env bash
# Touch ID for sudo (settings.macos.touch_id_sudo). Written for macOS's stock bash 3.2.
#
# macOS 14 (Sonoma) and newer read /etc/pam.d/sudo_local, which an update never overwrites; /etc/pam.d/sudo does
# `auth include sudo_local`. That is Apple's own way (see /etc/pam.d/sudo_local.template). Editing /etc/pam.d/sudo
# itself, as older guides do, is undone by every macOS update, so older macOS is left alone.
# Inside tmux/screen Touch ID needs pam_reattach (brew install pam-reattach); its line is added when the module is there.
# Nothing happens on a Mac without a Touch ID sensor (the password prompt stays as it is).
set -euo pipefail

DEST_DIR="{{ .chezmoi.destDir }}"
[[ -f "$DEST_DIR/.local/lib/chezmoi-utils.sh" ]] && . "$DEST_DIR/.local/lib/chezmoi-utils.sh"

LOCAL=/etc/pam.d/sudo_local
MARK="# dotfiles: Touch ID for sudo (settings.macos.touch_id_sudo)"

major="$(sw_vers -productVersion | cut -d. -f1)"
if [ "$major" -lt 14 ]; then
  info "Touch ID for sudo: needs macOS 14 or newer (sudo_local survives updates); this is macOS $major, left alone."
  exit 0
fi

# A sensor: the built-in one (AppleBiometricSensor) or a Magic Keyboard with Touch ID (AppleMesaAccessory).
# bioutil reports "supported" on every Apple Silicon Mac, even a Mac mini without a keyboard, so it only counts on Intel (T2).
has_sensor() {
  /usr/sbin/ioreg -rc AppleBiometricSensor 2> /dev/null | grep -q AppleBiometricSensor && return 0
  /usr/sbin/ioreg -rc AppleMesaAccessory 2> /dev/null | grep -q AppleMesaAccessory && return 0
  if [ "$(uname -m)" != arm64 ]; then
    /usr/bin/bioutil -rs 2> /dev/null | grep -Eq '(Biometrics|Touch ID) functionality: *1' && return 0
  fi
  return 1
}
if ! has_sensor; then
  info "Touch ID for sudo: this Mac has no Touch ID sensor, nothing to do."
  exit 0
fi

grep -q 'sudo_local' /etc/pam.d/sudo 2> /dev/null || {
  error "Touch ID for sudo: /etc/pam.d/sudo does not include sudo_local on this macOS, left alone."
  exit 0
}

# Homebrew's pam-reattach (Apple Silicon: /opt/homebrew, Intel: /usr/local), only when it is installed
reattach=""
if command -v brew > /dev/null 2>&1; then
  candidate="$(brew --prefix 2> /dev/null)/lib/pam/pam_reattach.so"
  [ ! -f "$candidate" ] || reattach="$candidate"
fi

block="$MARK
"
[ -z "$reattach" ] || block="${block}auth       optional       $reattach ignore_ssh
"
block="${block}auth       sufficient     pam_tid.so
"

current=""
[ ! -f "$LOCAL" ] || current="$(cat "$LOCAL")"
if [ -n "$current" ] && [ "$(printf '%s' "$current" | sed -n 1p)" != "$MARK" ]; then
  # a sudo_local that is not ours: keep it, and only add the lines if Touch ID is not enabled in it yet
  if printf '%s\n' "$current" | grep -Eq '^[[:space:]]*auth[[:space:]]+sufficient[[:space:]]+pam_tid\.so'; then
    info "Touch ID for sudo: already enabled in $LOCAL."
    exit 0
  fi
  block="$current

$block"
elif [ "$current" = "${block%?}" ]; then
  info "Touch ID for sudo: already enabled in $LOCAL."
  exit 0
fi

sudo -v || { error "Touch ID for sudo: sudo is needed to write $LOCAL and is not available; run this again from a terminal."; exit 0; }
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
printf '%s' "$block" > "$tmp"
# root:wheel, read-only: like the other files in /etc/pam.d
sudo install -m 444 -o root -g wheel "$tmp" "$LOCAL"
info "Touch ID for sudo: enabled in $LOCAL${reattach:+ (with pam_reattach, for tmux)}. Try it: sudo -k; sudo true"
{{ end -}}
