{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# Re-runs whenever the rendered mise config changes (runtimes in packages.yml, or this machine's tool plan).
# mise config hash: {{ includeTemplate "mise-config.toml" . | sha256sum }}

DEST_DIR="{{ .chezmoi.destDir }}"
[[ -f "$DEST_DIR/.local/lib/chezmoi-utils.sh" ]] && . "$DEST_DIR/.local/lib/chezmoi-utils.sh"

# Ansible (ansible/site.yml) installs the packages itself and runs chezmoi with DOTFILES_PACKAGES=ansible.
if [ "${DOTFILES_PACKAGES:-}" = ansible ]; then
  info "mise tools: installed by Ansible, nothing to do here."
  exit 0
fi

if ! command -v mise > /dev/null 2>&1; then
  info "Installing mise (official installer, prebuilt binary)"
  retry run sh -c "$(curl -fsSL --retry 3 https://mise.run)" || error "The mise installer failed (see above)."
fi
if ! command -v mise > /dev/null 2>&1; then
  error "mise is not installed, so its tools are skipped. Run  chezmoi apply  again once the network is back."
  exit 0
fi

install_status=0
{{ if and (eq .chezmoi.os "darwin") (ne .chezmoi.arch "arm64") -}}
# mise ships no prebuilt Ruby for Intel Macs, so Ruby compiles from source here. Keep the machine usable.
info "Intel Mac: Ruby is compiled from source (several minutes; 2 jobs, low priority)"
export MISE_JOBS=2 MAKE_OPTS=-j2 RUBY_MAKE_OPTS=-j2
info "Installing tools from ~/.config/mise/config.toml (and conf.d/)"
retry run nice -n 10 mise install || install_status=$?
{{- else -}}
info "Installing tools from ~/.config/mise/config.toml (and conf.d/)"
retry run mise install || install_status=$?
{{- end }}

run mise reshim || true
run mise doctor || true
if [ "$install_status" -ne 0 ]; then
  # not fatal: one tool that fails must not stop the scripts after this one (gems, Flutter, shell)
  error "mise install exited with status $install_status: some tools were NOT installed (see above). The rest of the setup continues; run  mise install  again once the cause is fixed."
fi
exit 0
{{ end -}}
