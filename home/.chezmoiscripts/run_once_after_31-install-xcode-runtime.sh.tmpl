{{- if and (eq .chezmoi.os "darwin") (ne ((index . "profile") | default "full") "cli") -}}
#!/usr/bin/env bash

DEST_DIR="{{ .chezmoi.destDir }}"
IOS_RUNTIME="{{ .toolchain.ios_runtime }}"

[[ -f "$DEST_DIR/.local/lib/chezmoi-utils.sh" ]] && . "$DEST_DIR/.local/lib/chezmoi-utils.sh"

if [ "${DOTFILES_XCODE:-install}" = skip ]; then
  info "DOTFILES_XCODE=skip: not installing the simulator runtime."
  exit 0
fi

if [ -z "$IOS_RUNTIME" ]; then
  info "No toolchain.ios_runtime pinned - skipping simulator runtime install."
  exit 0
fi

if ! command -v xcodes >/dev/null 2>&1; then
  error "xcodes not found - skipping simulator runtime install."
  exit 0
fi

aria2_args=()
if command -v aria2c >/dev/null 2>&1; then aria2_args=(--aria2 "$(command -v aria2c)"); fi

info "Installing iOS $IOS_RUNTIME simulator runtime"
run xcodes runtimes install "iOS $IOS_RUNTIME" ${aria2_args[@]+"${aria2_args[@]}"}
{{ end -}}
