{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
set -euo pipefail

HELP_DIR="{{ .chezmoi.destDir }}/.local/lib"
HELP_FILE="$HELP_DIR/chezmoi-utils.sh"

mkdir -p "$HELP_DIR"

cat > "$HELP_FILE" << 'BASH'
#!/usr/bin/env bash

# mise (official installer) lives in ~/.local/bin; its shims expose every installed runtime/tool
export PATH="{{ .chezmoi.destDir }}/.local/bin:{{ .chezmoi.destDir }}/.local/share/mise/shims:$PATH"
{{ if eq .chezmoi.os "darwin" -}}
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_INSTALL_CLEANUP=1
{{ if ne .chezmoi.arch "arm64" -}}
# Intel Macs: Homebrew no longer builds bottles (Tier 3). Never update, upgrade or compile implicitly.
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_INSTALL_UPGRADE=1
export HOMEBREW_MAKE_JOBS=2
{{ end -}}
{{ end -}}

function bail {
	error "$*"
	exit 99
}

function error {
	print "ERROR: $* \n" 1>&2
}

function info {
	print "INFO: $* \n"
}

function cleanup {
	exit_code=$?
	if [[ $exit_code -ne 0 ]]; then
        bail "Exiting remaining setup due to error. (Exit code: $exit_code)"
    else
        info "Setup completed successfully!"
    fi
}

function check_command {
    command -v "$1" &> /dev/null || bail "Unable to find $1, please install it and run this script again"
}

function linebreak {
	print "\n"
}

function print {
    echo -e "\n$@"
}

function run {
	local cmdline=
	for arg in "$@"; do
		case "${arg}" in
			*\ * | *\"*)
				cmdline="${cmdline} '${arg}'"
				;;
			*)
				cmdline="${cmdline} ${arg}"
				;;
		esac
	done
	info "Running${cmdline}" 1>&2
	"$@"
}
BASH

chmod +x "$HELP_FILE"
{{ end -}}
