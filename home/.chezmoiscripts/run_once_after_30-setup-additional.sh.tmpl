{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash

DEST_DIR="{{ .chezmoi.destDir }}"

[[ -f "$DEST_DIR/.local/lib/chezmoi-utils.sh" ]] && . "$DEST_DIR/.local/lib/chezmoi-utils.sh"

info "Installing NPM modules (node comes from mise)"
run mise exec -- npm i -g localtunnel
run mise exec -- npm i -g firebase-tools

{{ if and (eq .chezmoi.os "darwin") (ne ((index . "profile") | default "full") "cli") -}}
info "Configuring iterm2 aliases and shell integration"
run curl -L https://iterm2.com/shell_integration/install_shell_integration_and_utilities.sh | bash

if [ "${DOTFILES_MAS:-install}" = skip ]; then
  info "DOTFILES_MAS=skip: not upgrading Mac App Store apps."
elif command -v mas >/dev/null 2>&1; then
  info "Upgrade Mac App Store apps"
  run mas upgrade
else
  info "mas is not installed: not upgrading Mac App Store apps."
fi

{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
info "Final cleanup of brew"
run brew cleanup

{{ end -}}
info "Additional setup completed"
{{ end -}}
