{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash

DEST_DIR="{{ .chezmoi.destDir }}"

[[ -f "$DEST_DIR/.local/lib/chezmoi-utils.sh" ]] && . "$DEST_DIR/.local/lib/chezmoi-utils.sh"

continue_on_failure "additional setup"

{{ if .packages.npm -}}
info "Installing NPM modules (node comes from mise): {{ join " " .packages.npm }}"
{{ range .packages.npm -}}
retry run mise exec -- npm i -g {{ . | quote }} || error "npm could not install {{ . }} (see above)."
{{ end -}}
{{ else -}}
info "packages.npm is empty: no global NPM modules."
{{ end }}
{{ if and (eq .chezmoi.os "darwin") (ne ((index . "profile") | default "full") "cli") -}}
if [ -d /Applications/iTerm.app ] || [ -d "$DEST_DIR/Applications/iTerm.app" ]; then
  info "Configuring iterm2 aliases and shell integration"
  if iterm_installer="$(retry curl -fsSL https://iterm2.com/shell_integration/install_shell_integration_and_utilities.sh)"; then
    bash -c "$iterm_installer" || error "iTerm2 shell integration failed (see above)."
  else
    error "Could not download the iTerm2 shell integration."
  fi
else
  info "iTerm2 is not installed: skipping its shell integration."
fi

if [ "${DOTFILES_MAS:-install}" = skip ]; then
  info "DOTFILES_MAS=skip: not upgrading Mac App Store apps."
elif command -v mas >/dev/null 2>&1; then
  info "Upgrade Mac App Store apps"
  run mas upgrade || error "mas upgrade failed (see above)."
else
  info "mas is not installed: not upgrading Mac App Store apps."
fi

{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
info "Final cleanup of brew"
run brew cleanup || error "brew cleanup failed (harmless)."

{{ end -}}
info "Additional setup completed"
{{ end -}}
