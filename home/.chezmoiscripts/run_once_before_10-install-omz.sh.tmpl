{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash

DEST_DIR="{{ .chezmoi.destDir }}"

[[ -f "$DEST_DIR/.local/lib/chezmoi-utils.sh" ]] && . "$DEST_DIR/.local/lib/chezmoi-utils.sh"

info "chezmoi run_once_before_10-install-omz.sh: OS={{ .chezmoi.os }} ARCH={{ .chezmoi.arch }} DEST_DIR=$DEST_DIR"


continue_on_failure "Oh My Zsh"

info "Installing Oh My ZSH ...."

# download first: a network failure must not leave you without the old install
omz_installer="$(retry curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" || {
  error "Could not download the Oh My Zsh installer; keeping what is installed."
  exit 0
}

if [[ -d "${DEST_DIR}/.oh-my-zsh" ]]; then
  info "Removing old zsh directory before installation."
  run rm -rf "${DEST_DIR}/.oh-my-zsh"
fi

# ZSH is set explicitly: the installer honors an exported $ZSH (e.g. from an old ~/.zshenv, or a shell that
# points at another home) and would otherwise install there, or refuse because that folder exists.
run env ZSH="${DEST_DIR}/.oh-my-zsh" sh -c "$omz_installer" "" --unattended
{{ end -}}
