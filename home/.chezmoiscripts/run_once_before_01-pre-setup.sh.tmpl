{{- if eq .chezmoi.os "darwin" -}}
{{- $profile := (index . "profile") | default "full" -}}
#!/usr/bin/env bash
set -euo pipefail

DEST_DIR="{{ .chezmoi.destDir }}"
CHEZ_ARCH="{{ .chezmoi.arch }}"

[[ -f "$DEST_DIR/.local/lib/chezmoi-utils.sh" ]] && . "$DEST_DIR/.local/lib/chezmoi-utils.sh"

info "chezmoi prepare: macOS ARCH=$CHEZ_ARCH DEST_DIR=$DEST_DIR"

{{ if ne $profile "cli" -}}
# --- Rosetta (Apple Silicon only; for GUI apps, so not in the cli profile) ---
if [ "$CHEZ_ARCH" = "arm64" ]; then
  run /usr/sbin/softwareupdate --install-rosetta --agree-to-license >/dev/null 2>&1 || \
    error "Rosetta install returned non-zero; continuing (may already be installed)."
fi

{{ end -}}
# --- Xcode Command Line Tools ---
# Headless first (the softwareupdate route Homebrew's own installer uses: no dialog to click), then the
# GUI prompt as a fallback. bootstrap.sh does the same before chezmoi starts, because on a bare Mac the
# first `git` call (which `chezmoi init <repo>` makes) is what pops up that dialog.
install_clt_headless() {
  local trigger=/tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress-file label
  touch "$trigger"
  label="$(softwareupdate -l 2>/dev/null | grep -B 1 -E 'Command Line Tools' | awk -F'*' '/^ *\*/ {print $2}' \
    | sed -e 's/^ *Label: //' -e 's/^ *//' | sort -V | tail -n1)" || label=""   # no match must not end the script
  if [ -n "$label" ]; then
    info "Installing $label"
    run sudo softwareupdate -i "$label" --verbose || true
    run sudo xcode-select --switch /Library/Developer/CommandLineTools || true
  fi
  rm -f "$trigger"
}

if ! xcode-select -p >/dev/null 2>&1; then
  install_clt_headless
fi
if ! xcode-select -p >/dev/null 2>&1; then
  info "Installing Xcode Command Line Tools (GUI prompt)"
  run xcode-select --install >/dev/null 2>&1 || error "xcode-select --install returned non-zero."
  elapsed=0
  while ! xcode-select -p >/dev/null 2>&1; do
    sleep 6; elapsed=$((elapsed + 6))
    if [ "$elapsed" -ge 900 ]; then error "Timed out waiting for Xcode CLT."; break; fi
  done
fi
if xcode-select -p >/dev/null 2>&1; then info "Xcode Command Line Tools are installed."; fi

# --- Homebrew (casks + a few CLI tools only; runtimes come from mise) ---
if [ "$CHEZ_ARCH" = "arm64" ]; then BREW_BIN="/opt/homebrew/bin/brew"; else BREW_BIN="/usr/local/bin/brew"; fi

# Everything below needs brew. Stop here with the reason instead of failing later with "brew: command not found".
# Not fatal for chezmoi: the dotfiles and the mise / shell steps still work without brew.
if [ ! -x "$BREW_BIN" ]; then
  error "Homebrew is not at $BREW_BIN, so the Homebrew steps are skipped. bootstrap.sh installs it (Homebrew's own installer refuses Intel Macs, so it does that part by hand): run bootstrap.sh, then  chezmoi apply  again."
  exit 0
fi
eval "$("$BREW_BIN" shellenv)"   # PATH for later shells is set in ~/.zprofile / ~/.zshenv
command -v brew >/dev/null 2>&1 || { error "brew is still not on PATH after $BREW_BIN shellenv; skipping the Homebrew steps."; exit 0; }

{{ if ne $profile "cli" -}}
{{ if eq .chezmoi.arch "arm64" -}}
info "Installing mas, aria2 and xcodes (bottles only - never compile)"
# One at a time: a failure (or xcodes already installed from homebrew/core, which cannot coexist with the
# xcodesorg/made tap's) must not stop the others from installing.
for formula in mas aria2 xcodesorg/made/xcodes; do
  if brew list --formula "${formula##*/}" > /dev/null 2>&1; then
    info "${formula##*/} is already installed"
  else
    retry run brew install --force-bottle "$formula" || error "$formula failed to install from a bottle."
  fi
done
info "Linking binaries of brew packages so process won't fail"
for pkg in mas xcodes aria2; do
  if brew list --formula "$pkg" > /dev/null 2>&1; then
    if run brew unlink "$pkg" && run brew link "$pkg"; then :; else error "could not relink $pkg"; fi
  fi
done
xcodes_run() { xcodes "$@"; }
have_xcodes() { command -v xcodes >/dev/null 2>&1; }
{{- else -}}
# Intel (Homebrew Tier 3): mas still has a bottle; aria2 and xcodes do not. xcodes ships a prebuilt
# macOS x86_64 release, so mise provides it; aria2 is only a download accelerator and is skipped.
info "Installing mas (bottle only - never compile)"
if brew list --formula mas > /dev/null 2>&1; then
  info "mas is already installed"
else
  retry run brew install --force-bottle mas || error "No mas bottle for this macOS; install mas from its GitHub release."
fi
if brew list --formula mas > /dev/null 2>&1; then
  if run brew unlink mas && run brew link mas; then :; else error "could not relink mas"; fi
fi
if ! command -v mise >/dev/null 2>&1; then
  info "Installing mise (provides xcodes on Intel)"
  retry run sh -c "$(curl -fsSL --retry 3 https://mise.run)" || error "mise installer returned non-zero."
fi
xcodes_run() { mise exec xcodes@latest -- xcodes "$@"; }
have_xcodes() { command -v mise >/dev/null 2>&1; }
{{- end }}

# Which Xcode: DOTFILES_XCODE_VERSION, else toolchain.xcode_version, else the newest release this Mac can run.
# DOTFILES_XCODE=skip leaves Xcode out (a CI runner has no Apple ID to log in with).
XCODE_VERSION="${DOTFILES_XCODE_VERSION:-{{ .toolchain.xcode_version }}}"
if [ "${DOTFILES_XCODE:-install}" = skip ]; then
  info "DOTFILES_XCODE=skip: not installing Xcode."
elif ! have_xcodes; then
  info "xcodes is not available - skipping the Xcode install."
else
  if [ -z "$XCODE_VERSION" ]; then
    # not `xcodes install --latest`: that installs the newest Xcode even when this Mac is too old (or, for
    # Xcode 27, an Intel Mac) to run it. xcode-pick.py only considers releases this Mac can run, and, when xcodes
    # can list them, only builds xcodes offers for this CPU (`xcodes list` itself shows
{{- if eq .chezmoi.arch "arm64" }} Apple Silicon builds on an Apple Silicon Mac,
    # so ask for the universal ones too).
    xcodes_listed="$(mktemp)"
    if xcodes_run list --architecture appleSilicon --architecture universal > "$xcodes_listed" 2>/dev/null; then
{{- else }} universal builds on an Intel Mac, so ask for Intel-only ones too).
    xcodes_listed="$(mktemp)"
    if xcodes_run list --architecture universal --architecture x86_64 > "$xcodes_listed" 2>/dev/null; then
{{- end }}
      pick_args=(--listed "$xcodes_listed")
    else
      pick_args=()
    fi
    if XCODE_VERSION="$(python3 "$DEST_DIR/.local/lib/xcode-pick.py" xcode ${pick_args[@]+"${pick_args[@]}"})" \
        || XCODE_VERSION="$(python3 "$DEST_DIR/.local/lib/xcode-pick.py" xcode)"; then
      info "No Xcode version set, the newest release this Mac can run is $XCODE_VERSION"
    else
      XCODE_VERSION=""
      error "Could not work out the newest Xcode for this Mac, skipping. Set one with DOTFILES_XCODE_VERSION."
    fi
  fi
  if [ -z "$XCODE_VERSION" ]; then
    :
  elif xcodes_run installed 2>/dev/null | grep -q "^$XCODE_VERSION"; then
    info "Xcode $XCODE_VERSION is already installed."
  else
    aria2_args=()
    if command -v aria2c >/dev/null 2>&1; then aria2_args=(--aria2 "$(command -v aria2c)"); fi
    # Apple ID: from the environment (XCODES_USERNAME/XCODES_PASSWORD/FASTLANE_SESSION), else from Bitwarden if it
    # is on, else xcodes asks. The two-factor code can't be automated, only skipped by reusing a fastlane session.
{{- if (index . "bitwarden") }}
    if [ -z "${DOTFILES_XCODE_XIP:-}" ]; then load_apple_credentials "{{ .settings.apple.bitwarden_item }}"; fi
{{- end }}
    auth_args=()
    if [ -n "${FASTLANE_SESSION:-}" ]; then auth_args=(--use-fastlane-auth); fi
    # DOTFILES_XCODE_XIP=/path/Xcode_26.6.xip installs a download you made yourself: no Apple ID, no code
    xip_args=()
    if [ -n "${DOTFILES_XCODE_XIP:-}" ]; then xip_args=(--path "$DOTFILES_XCODE_XIP"); fi
    use_terminal_stdin   # xcodes asks for the two-factor code on stdin
    info "Installing Xcode $XCODE_VERSION"
    # ${arr[@]+...}: macOS bash 3.2 treats an empty array as unset under `set -u`
    if run xcodes_run install "$XCODE_VERSION" --experimental-unxip --select --empty-trash ${aria2_args[@]+"${aria2_args[@]}"} ${auth_args[@]+"${auth_args[@]}"} ${xip_args[@]+"${xip_args[@]}"}; then
      # a version can exist as an Apple Silicon build and a universal build; make sure this Mac got a usable one
      xcode_app="$(xcode-select -p 2>/dev/null)"; xcode_app="${xcode_app%/Contents/Developer}"
      if [ -x "$xcode_app/Contents/MacOS/Xcode" ]; then
        xcode_archs="$(lipo -archs "$xcode_app/Contents/MacOS/Xcode" 2>/dev/null)"
        case " $xcode_archs " in
          *" {{ if eq .chezmoi.arch "arm64" }}arm64{{ else }}x86_64{{ end }} "*) ;;
          *) error "$xcode_app is built for: $xcode_archs, not for this Mac. Reinstall it with xcodes." ;;
        esac
      fi
    else
      error "The Xcode install did not finish. Run \`xcodes install $XCODE_VERSION\` again later."
    fi
  fi
fi
{{ else -}}
info "Profile cli: no App Store tools, Xcode or simulator runtime."
{{ end }}
info "prepare-system completed successfully."
{{ end -}}
