{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail

DEST_DIR="{{ .chezmoi.destDir }}"
CHEZ_ARCH="{{ .chezmoi.arch }}"
XCODE_VERSION="{{ .toolchain.xcode_version }}"

[[ -f "$DEST_DIR/.local/lib/chezmoi-utils.sh" ]] && . "$DEST_DIR/.local/lib/chezmoi-utils.sh"

info "chezmoi prepare: macOS ARCH=$CHEZ_ARCH DEST_DIR=$DEST_DIR"

# --- Rosetta (Apple Silicon only) ---
if [ "$CHEZ_ARCH" = "arm64" ]; then
  run /usr/sbin/softwareupdate --install-rosetta --agree-to-license >/dev/null 2>&1 || \
    error "Rosetta install returned non-zero; continuing (may already be installed)."
fi

# --- Xcode Command Line Tools ---
if ! xcode-select -p >/dev/null 2>&1; then
  info "Installing Xcode Command Line Tools (GUI prompt)"
  run xcode-select --install >/dev/null 2>&1 || error "xcode-select --install returned non-zero."
  elapsed=0
  while ! xcode-select -p >/dev/null 2>&1; do
    sleep 6; elapsed=$((elapsed + 6))
    if [ "$elapsed" -ge 900 ]; then error "Timed out waiting for Xcode CLT."; break; fi
  done
else
  info "Xcode Command Line Tools already present."
fi

# --- Homebrew (casks + a few CLI tools only; runtimes come from mise) ---
if [ "$CHEZ_ARCH" = "arm64" ]; then BREW_BIN="/opt/homebrew/bin/brew"; else BREW_BIN="/usr/local/bin/brew"; fi

if [ ! -x "$BREW_BIN" ]; then
  info "Installing Homebrew"
  run /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || \
    error "Homebrew installer returned non-zero."
fi
eval "$("$BREW_BIN" shellenv)"   # PATH for later shells is set in ~/.zprofile / ~/.zshenv

info "Installing mas, aria2 and xcodes (bottles only - never compile on Intel)"
run brew install --force-bottle mas aria2 || error "mas/aria2 have no bottle for this macOS."
run brew install --force-bottle xcodes || \
  error "No xcodes bottle. Use the xcodes-app cask (already in packages.yml) instead."

if [ -n "$XCODE_VERSION" ] && command -v xcodes >/dev/null 2>&1; then
  aria2_args=()
  if command -v aria2c >/dev/null 2>&1; then aria2_args=(--aria2 "$(command -v aria2c)"); fi
  info "Installing pinned Xcode $XCODE_VERSION (requires Apple ID login)"
  run xcodes install "$XCODE_VERSION" --experimental-unxip --select --empty-trash "${aria2_args[@]}"
else
  info "No toolchain.xcode_version pinned (or xcodes missing) - skipping Xcode install."
fi

info "prepare-system completed successfully."
{{ end -}}
