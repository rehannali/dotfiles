{{- if and (index . "bitwarden") .secrets.env -}}
# Written by chezmoi from Bitwarden, see .chezmoidata/secrets.yml. Edits here are overwritten.
{{ range $var, $secret := .secrets.env -}}
{{-   if not (regexMatch "^[A-Za-z_][A-Za-z0-9_]*$" $var) -}}{{ fail (printf "secrets.env: %q is not a valid variable name" $var) }}{{- end -}}
{{-   $field := (index $secret "field") | default "password" -}}
{{-   $value := "" -}}
{{-   if eq $field "password" -}}{{ $value = (bitwarden "item" $secret.item).login.password }}
{{-   else if eq $field "username" -}}{{ $value = (bitwarden "item" $secret.item).login.username }}
{{-   else if eq $field "notes" -}}{{ $value = (bitwarden "item" $secret.item).notes }}
{{-   else -}}{{ $value = (index (bitwardenFields "item" $secret.item) $field).value }}
{{-   end -}}
export {{ $var }}='{{ $value | replace "'" "'\\''" }}'
{{ end -}}
{{- end -}}
