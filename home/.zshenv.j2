[[ -f "$HOME/.zsh/functions.zsh" ]] && source "$HOME/.zsh/functions.zsh"

# Keep PATH free of duplicates, so prepending an entry again simply moves it to the front.
typeset -U path PATH

export ZSH="$HOME/.oh-my-zsh"
export LANG={{ settings.locale }}
export SPACESHIP_CONFIG="$HOME/.config/spaceship/spaceship.zsh"

{% if dotfiles_os == 'darwin' %}
export HOMEBREW_NO_ANALYTICS=1
{% if dotfiles_arch == 'arm64' %}
# Apple Silicon (Tier 1): Homebrew lives in /opt/homebrew
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
{% else %}
# Intel: no Homebrew. Command-line tools from MacPorts (and mise, whose shims come first below); apps from mycask
export PATH="/opt/local/bin:/opt/local/sbin:$PATH"
export MANPATH="/opt/local/share/man:$MANPATH"
{% endif %}

if chrome_path=$(locate_chrome); then
  export CHROME_EXECUTABLE="$chrome_path"
fi
{% endif %}

{% if dotfiles_os == 'linux' %}
# Ubuntu's /etc/zsh/zshrc runs compinit itself; zsh-autocomplete (and Oh My Zsh) want to be the only ones that do
skip_global_compinit=1

{% endif %}
export PATH="$HOME/fvm/default/bin:$PATH"
# mise itself, and its shims: IDEs and non-interactive shells (Xcode build phases, Android Studio,
# cron) never run `mise activate`, but they do read this file, so they still find every runtime.
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

# settings.shell.env and settings.shell.path (docs/configuration.md)
{% for name, value in settings.shell.env.items() %}
export {{ name }}={{ value | string | to_json }}
{% endfor %}
{% for dir in settings.shell.path | reverse %}
export PATH={{ dir | to_json }}:"$PATH"
{% endfor %}
