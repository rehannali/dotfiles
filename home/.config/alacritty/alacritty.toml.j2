import = [
    "~/.config/alacritty/themes/themes/{{ settings.terminal.alacritty_theme }}.toml"
]

[ env ]
TERM = "xterm-256color"

[window]
dimensions.columns = 200
dimensions.lines = 60

padding.x = 10
padding.y = 10

position.x = 350
position.y = 350

decorations = "Buttonless"

opacity = 0.85
blur = true

option_as_alt = "Both"

[scrolling]
history = 100000
multiplier = 10

[cursor]
style.shape = "Beam"
style.blinking = "Never"

[font]
normal.family = {{ settings.terminal.font | to_json }}

size = {{ settings.terminal.font_size }}
