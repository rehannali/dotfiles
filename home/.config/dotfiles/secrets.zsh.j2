# Written by Ansible: the UPPER_CASE fields of the Bitwarden items dotfiles.all / dotfiles.<group> / dotfiles.<host>,
# then ~/.config/dotfiles/env and the run's environment, and inventory/group_vars/all/secrets.yml. Read by ~/.zshenv
# and ~/.bashrc. Edits here are overwritten: change the vault (or ~/.config/dotfiles/env) and run dot apply.
# the names this setup exports (here or in your own shell files): a run ignores them in its own environment, so a value
# removed from the vault or ~/.config/dotfiles/env is not taken back from the shell
export DOTFILES_EXPORTED='{{ (dotfiles_secrets | default({})).keys() | join(' ') }}'
{% for var, value in (dotfiles_secret_values | default({})).items() %}
export {{ var }}='{{ value | replace("'", "'\\''") }}'
{% endfor %}
