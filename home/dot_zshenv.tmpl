[[ -f "$HOME/.zsh/functions.zsh" ]] && source "$HOME/.zsh/functions.zsh"

# Keep PATH free of duplicates, so prepending an entry again simply moves it to the front.
typeset -U path PATH

export ZSH="$HOME/.oh-my-zsh"
export LANG={{ .settings.locale }}
export SPACESHIP_CONFIG="$HOME/.config/spaceship/spaceship.zsh"

{{ if eq .chezmoi.os "darwin" -}}
export HOMEBREW_NO_ANALYTICS=1
{{ if eq .chezmoi.arch "arm64" -}}
# Apple Silicon (Tier 1): Homebrew lives in /opt/homebrew
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
{{ else -}}
# Intel (Tier 3): Homebrew lives in /usr/local. Never update, upgrade or compile implicitly.
export PATH="/usr/local/bin:/usr/local/sbin:$PATH"
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_INSTALL_UPGRADE=1
export HOMEBREW_NO_INSTALL_CLEANUP=1
export HOMEBREW_MAKE_JOBS=2
{{ end -}}

if chrome_path=$(locate_chrome); then
  export CHROME_EXECUTABLE="$chrome_path"
fi
{{ end -}}

export PATH="$HOME/fvm/default/bin:$PATH"
# mise itself, and its shims: IDEs and non-interactive shells (Xcode build phases, Android Studio,
# cron) never run `mise activate`, but they do read this file, so they still find every runtime.
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

# Custom ENV Variable
export PYTHONDONTWRITEBYTECODE=1
export PYTHONUNBUFFERED=1
