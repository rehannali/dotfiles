[[ -f "$HOME/.zsh/functions.zsh" ]] && source "$HOME/.zsh/functions.zsh"

export ZSH="$HOME/.oh-my-zsh"
export LANG=en_US.UTF-8
export SPACESHIP_CONFIG="$HOME/.config/spaceship/spaceship.zsh"

{{ if eq .chezmoi.os "darwin" -}}
# Homebrew: prefix differs on Intel vs Apple Silicon
{{ if eq .chezmoi.arch "arm64" -}}
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
{{ else -}}
export PATH="/usr/local/bin:/usr/local/sbin:$PATH"
{{ end -}}
# Intel (Tier 3): never auto-update or compile in the background
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_INSTALL_CLEANUP=1
export HOMEBREW_MAKE_JOBS=2

if chrome_path=$(locate_chrome); then
  export CHROME_EXECUTABLE="$chrome_path"
fi
{{ end -}}

export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/fvm/default/bin:$PATH"
# mise shims: lets IDEs and non-interactive shells (Xcode scripts, Android Studio) find runtimes
export PATH="$HOME/.local/share/mise/shims:$PATH"

export SDKMAN_DIR="$HOME/.sdkman"   # legacy; safe to delete once Java comes from mise

# Custom ENV Variable
export PYTHONDONTWRITEBYTECODE=1
export PYTHONUNBUFFERED=1
