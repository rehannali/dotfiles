{% if dotfiles_os == 'darwin' %}
# Login shells on macOS run /etc/zprofile -> path_helper, which re-sorts PATH and pushes the entries
# set in ~/.zshenv behind /usr/bin. Put Homebrew and mise back in front.
{% if dotfiles_arch == 'arm64' %}
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
{% else %}
# Intel: mycask's bottles, in Homebrew's old prefix
export PATH="/usr/local/bin:/usr/local/sbin:$PATH"
{% endif %}

# Added by Toolbox App
export PATH="$PATH:/usr/local/bin"

# Added by OrbStack: command-line tools and integration
source "$HOME/.orbstack/shell/init.zsh" 2>/dev/null || :
{% endif %}

# mise shims and ~/.local/bin (mise, pipx, uv tools) ahead of the system directories
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"
