{{- /*
  Resolves packages.tools into one list per package manager for THIS machine and prints it as
  JSON: {"apt": ["pkg", ...], "brew": [{"name", "args", "prebuilt", "source", "port", "mise_fallback"}, ...],
         "mise": ["id", ...], "expect": [{"name", "kind", "via", "bin", "source", "port", "mise_fallback"}, ...]}
  `expect` is what scripts/check-install.py verifies after an apply: for every selected tool, the manager
  that must provide it and the command it must put on PATH ("" = a library, nothing to run).

  This is the only place the package policy is encoded. Consumers parse it with
      {{ $plan := includeTemplate "tool-plan" . | fromJson }}
  (mise config, brew script, apt script), so they can never disagree about who installs what.

                   cli, or any entry with a mise key      system / apple, no mise key
    Apple Silicon  brew (mise only if there is no brew)   brew
    Intel Mac      mise (brew if mise_intel: false)       brew, bottle-only (checked at install time)
                   ... brew fallback for mise_intel: false tools may build from source: they must be installed
    Linux          mise (apt if there is no mise key)     apt
    Windows        nothing here (winget)

  profile "cli" (servers) additionally drops every kind: apple tool; casks, App Store apps and GUI configs
  are handled by the scripts and .chezmoiignore.

  "port" (Intel Macs only, else ""): the MacPorts port that installs the tool when Homebrew has no bottle for it. It
  is a fallback inside the brew list, decided at install time (run_onchange_11-install-packages), so the tool is
  still installed by one manager only, and Homebrew wins whenever it can.
  "mise_fallback" (Intel Macs only, else ""): the mise tool id tried when neither a bottle nor MacPorts works.

  Exactly one manager is chosen per tool, so nothing is ever installed twice.
*/ -}}
{{- $os := .chezmoi.os -}}
{{- /* profile lives in chezmoi.toml; machines that never re-ran `chezmoi init` have none: full */ -}}
{{- $profile := (index . "profile") | default "full" -}}
{{- $appleSilicon := and (eq $os "darwin") (eq .chezmoi.arch "arm64") -}}
{{- $intel := and (eq $os "darwin") (not $appleSilicon) -}}
{{- $mise := list -}}
{{- $brew := list -}}
{{- $apt := list -}}
{{- $expect := list -}}
{{- if or (eq $os "darwin") (eq $os "linux") -}}
{{- range .packages.tools -}}
  {{- $t := . -}}
  {{- if not (has $t.kind (list "cli" "system" "apple")) -}}
    {{- fail (printf "packages.tools %q: kind must be cli, system or apple (got %q)" $t.name $t.kind) -}}
  {{- end -}}
  {{- if and (eq $t.kind "cli") (not (hasKey $t "mise")) -}}
    {{- fail (printf "packages.tools %q: kind cli needs a mise key (use kind system for brew/apt-only tools)" $t.name) -}}
  {{- end -}}

  {{- $via := "" -}}
  {{- if and (eq $t.kind "apple") (or (ne $os "darwin") (eq $profile "cli")) -}}
    {{- /* macOS only, and not part of the command-line-only profile */ -}}
  {{- else if $appleSilicon -}}
    {{- if hasKey $t "brew" -}}{{- $via = "brew" -}}
    {{- else if hasKey $t "mise" -}}{{- $via = "mise" -}}
    {{- end -}}
  {{- else if $intel -}}
    {{- if and (hasKey $t "mise") (ne (get $t "mise_intel" | toString) "false") -}}{{- $via = "mise" -}}
    {{- else if hasKey $t "brew" -}}{{- $via = "brew" -}}
    {{- end -}}
  {{- else -}}
    {{- if hasKey $t "mise" -}}{{- $via = "mise" -}}
    {{- else if hasKey $t "apt" -}}{{- $via = "apt" -}}
    {{- end -}}
  {{- end -}}

  {{- if eq $via "mise" -}}
    {{- $id := get $t "mise" -}}
    {{- /* mise_intel: "cargo:foo" = Intel installs that mise tool instead (mise_intel: false means brew) */ -}}
    {{- if and $intel (hasKey $t "mise_intel") (kindIs "string" (get $t "mise_intel")) -}}{{- $id = get $t "mise_intel" -}}{{- end -}}
    {{- $mise = append $mise $id -}}
  {{- else if eq $via "brew" -}}
    {{- $brew = append $brew (dict "name" (get $t "brew") "args" (get $t "brew_args" | toString) "prebuilt" (eq (get $t "prebuilt" | toString) "true") "source" (eq (get $t "mise_intel" | toString) "false") "port" (ternary (get $t "port" | toString) "" $intel) "mise_fallback" (ternary (get $t "mise_fallback" | toString) "" $intel)) -}}
  {{- else if eq $via "apt" -}}
    {{- $apt = append $apt (get $t "apt") -}}
  {{- end -}}

  {{- if $via -}}
    {{- $bin := "" -}}
    {{- if hasKey $t "bin" -}}{{- $bin = get $t "bin" -}}
    {{- else if ne $t.kind "system" -}}{{- $bin = $t.name -}}
    {{- end -}}
    {{- $expect = append $expect (dict "name" $t.name "kind" $t.kind "via" $via "bin" $bin "source" (eq (get $t "mise_intel" | toString) "false") "port" (ternary (get $t "port" | toString) "" (and $intel (eq $via "brew"))) "mise_fallback" (ternary (get $t "mise_fallback" | toString) "" (and $intel (eq $via "brew")))) -}}
  {{- end -}}
{{- end -}}
{{- end -}}
{{- dict "apt" $apt "brew" $brew "mise" $mise "expect" $expect | toJson -}}
