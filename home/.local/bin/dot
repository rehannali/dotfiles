#!/usr/bin/env bash
# dot: everyday use of the dotfiles on this machine (~/.local/bin/dot, a link into your checkout of the repo).
#
#   dot                 same as dot apply
#   dot apply [ARGS]    set this machine up from the checkout as it is, without pulling (ARGS go to ansible-playbook,
#                       e.g. --tags dotfiles, --tags packages, -e install_casks=false)
#   dot sync [ARGS]     pull the latest from GitHub, then apply: how another machine's changes arrive here
#   dot check [ARGS]    what apply would change, without changing anything (--check --diff)
#   dot save [MESSAGE]  commit everything changed in the checkout and push it, for the other machines to sync
#   dot status          this machine's host and group, its saved choices, what is changed / not pushed in the checkout
#   dot audit           check what is installed against what this machine should have
#   dot remember 'KEY: VALUE' ...
#                       keep a setting for this machine on every run, e.g. 'gui_apps: false' (no arguments: ask
#                       for a missing git name / email)
#   dot cd              print the repo path:  cd "$(dot cd)"
#
# Which machine this is (host and group in ansible/inventory/hosts.yml) comes from ~/.config/dotfiles/machine,
# written by every run. Override for one command with DOTFILES_HOST / DOTFILES_GROUP.
# This machine's own choices (bootstrap.sh options, your name and email) are in ~/.config/dotfiles/local.yml, an
# inventory every run reads: they win over group_vars, and lose to host_vars/<host>.yml in the repo and to -e.
# With bitwarden on, dot unlocks the vault first, unless BW_SESSION is set: with the login bootstrap.sh kept in the
# Keychain / Secret Service (dotfiles-secret), else BW_PASSWORD, else it asks.
set -euo pipefail

MACHINE_FILE="$HOME/.config/dotfiles/machine"
# the repo: DOTFILES_DIR, else where the last run applied it from (the machine file), else the checkout this script
# lives in (~/.local/bin/dot is a link into it), else ~/.dotfiles
repo_of_self() {
  local self="${BASH_SOURCE[0]}" target
  while [ -L "$self" ]; do
    target="$(readlink "$self")"
    case "$target" in /*) self="$target" ;; *) self="$(dirname "$self")/$target" ;; esac
  done
  (cd "$(dirname "$self")/../../.." 2> /dev/null && [ -f ansible/site.yml ] && pwd) || true
}
REPO="${DOTFILES_DIR:-}"
[ -n "$REPO" ] || [ ! -f "$MACHINE_FILE" ] || REPO="$(sed -n 's/^DOTFILES_DIR=//p' "$MACHINE_FILE")"
[ -n "$REPO" ] && [ -d "$REPO/ansible" ] || REPO="$(repo_of_self)"
[ -n "$REPO" ] || REPO="$HOME/.dotfiles"
LOCAL_VARS="$HOME/.config/dotfiles/local.yml"
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

die() { printf '\033[1;31mdot:\033[0m %s\n' "$*" >&2; exit 1; }
say() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
yaml_str() { local s="${1//\\/\\\\}"; printf '"%s"' "${s//\"/\\\"}"; }
has_tty() { ( : < /dev/tty ) 2> /dev/null; }

case "${1:-}" in -h | --help | help) sed -n '2,/^set -euo/p' "$0" | sed '$d;s/^# \{0,1\}//'; exit 0 ;; esac
[ -d "$REPO/ansible" ] || die "no checkout at $REPO (set DOTFILES_DIR, or run bootstrap.sh first)"
host="${DOTFILES_HOST:-}"
group="${DOTFILES_GROUP:-}"
if [ -f "$MACHINE_FILE" ]; then   # written by the report role: DOTFILES_HOST=... and DOTFILES_GROUP=... lines
  [ -n "$host" ] || host="$(sed -n 's/^DOTFILES_HOST=//p' "$MACHINE_FILE")"
  [ -n "$group" ] || group="$(sed -n 's/^DOTFILES_GROUP=//p' "$MACHINE_FILE")"
fi
[ -n "$host" ] || host="$(hostname -s 2> /dev/null || hostname)"
TMP="$(mktemp -d)"
RUN_SUDOERS=/etc/sudoers.d/dotfiles-run
SUDO_KEEPALIVE_PID=""
cleanup() {
  [ ! -f "$RUN_SUDOERS" ] || sudo -n rm -f "$RUN_SUDOERS" 2> /dev/null || true
  [ -z "$SUDO_KEEPALIVE_PID" ] || kill "$SUDO_KEEPALIVE_PID" 2> /dev/null || true
  rm -rf "$TMP"
}
trap cleanup EXIT

# DOTFILES_SUDO_PASSWORD: the sudo password, for runs nobody types into (CI, a self-hosted runner, a script); it is
# also Ansible's become password unless DOTFILES_BECOME_PASSWORD is set. Read from the environment, never written down.
sudo_unlock() {
  if [ -n "${DOTFILES_SUDO_PASSWORD:-}" ]; then
    printf '%s\n' "$DOTFILES_SUDO_PASSWORD" | sudo -S -p '' -v || die "sudo did not take DOTFILES_SUDO_PASSWORD"
  else
    sudo -v
  fi
}
# --become-password-file for ansible-playbook: a script in DIR that prints the password, so it is in no file
become_password_file() {
  [ -n "${DOTFILES_BECOME_PASSWORD:-${DOTFILES_SUDO_PASSWORD:-}}" ] || return 1
  # shellcheck disable=SC2016  # expanded when Ansible runs the script, not here
  printf '%s\n' '#!/bin/sh' 'printf "%s\n" "${DOTFILES_BECOME_PASSWORD:-$DOTFILES_SUDO_PASSWORD}"' > "$1/become-password"
  chmod 0700 "$1/become-password"
  printf '%s\n' "$1/become-password"
}

# macOS remembers a sudo unlock per terminal, and with Touch ID (sudo_local) sudo waits for a fingerprint instead of
# the password prompt Ansible answers, so Ansible's sudo times out. For the run, one unlock counts for every terminal
# (a sudoers drop-in, removed at the end) and is kept fresh while long steps (port builds) run.
sudo_for_run() {
  [ "$(uname -s)" = Darwin ] && [ "$(id -u)" -ne 0 ] || return 0
  say "Unlocking sudo for this run (it stays unlocked until the run ends)"
  sudo_unlock
  if ! { printf 'Defaults:%s timestamp_type=global\n' "$(id -un)" | sudo tee "$RUN_SUDOERS.new" > /dev/null \
      && sudo chmod 0440 "$RUN_SUDOERS.new" && sudo /usr/sbin/visudo -cqf "$RUN_SUDOERS.new" \
      && sudo mv "$RUN_SUDOERS.new" "$RUN_SUDOERS"; }; then
    sudo rm -f "$RUN_SUDOERS.new"; die "could not unlock sudo"
  fi
  sudo_unlock
  ( while true; do sudo -n true 2> /dev/null || exit; sleep 50; kill -0 "$$" 2> /dev/null || exit; done ) &
  SUDO_KEEPALIVE_PID=$!
  disown "$SUDO_KEEPALIVE_PID" 2> /dev/null || true
}

# remember 'KEY: VALUE' ...: add or replace this machine's settings in local.yml (VALUE is YAML)
# older runs kept the typed name / email as git_name / git_email, which would win over the vault: now <key>_asked
migrate_local_vars() {
  [ -f "$LOCAL_VARS" ] && grep -qE '^      git_(name|email): ' "$LOCAL_VARS" || return 0
  perl -pi -e 's/^(      git_(?:name|email)):/$1_asked:/' "$LOCAL_VARS"
}
remember() {
  local line key keys=" "
  for line in "$@"; do keys="$keys${line%%:*} "; done
  mkdir -p "$(dirname "$LOCAL_VARS")"
  migrate_local_vars
  {
    printf '%s\n' "# This machine's choices (bootstrap.sh options, the name and email you typed); every dot run uses them." \
      "# Change or delete a line to change one; host_vars/<host>.yml in the repo and -e KEY=VALUE win over them." \
      "all:" "  hosts:" "    $host:"
    if [ -f "$LOCAL_VARS" ]; then
      grep -E '^      [a-z_]+: ' "$LOCAL_VARS" | while IFS= read -r line; do
        key="${line#      }"; key="${key%%:*}"
        case "$keys" in *" $key "*) ;; *) printf '%s\n' "$line" ;; esac
      done || true
    fi
    for line in "$@"; do printf '      %s\n' "$line"; done
  } > "$TMP/local.yml"
  chmod 600 "$TMP/local.yml"
  mv "$TMP/local.yml" "$LOCAL_VARS"
}

# the inventory for this machine: hosts.yml, its group if it is not in there yet, and its saved choices
inv=(-i inventory/hosts.yml)
inventory() {
  command -v ansible-playbook > /dev/null 2>&1 || die "Ansible is not installed: run bootstrap.sh (or: uv tool install --python 3.13 ansible-core)"
  cd "$REPO/ansible"
  export ANSIBLE_CONFIG="$REPO/ansible/ansible.cfg"
  if ! ansible-inventory -i inventory/hosts.yml --host "$host" > /dev/null 2>&1; then
    [ -n "$group" ] || die "$host is not in ansible/inventory/hosts.yml; add it there, or say which group: DOTFILES_GROUP=mac_work dot"
    # Ansible only reads a YAML inventory whose name ends in .yml
    printf 'all:\n  children:\n    %s:\n      hosts:\n        %s:\n' "$group" "$host" > "$TMP/host.yml"
    inv+=(-i "$TMP/host.yml")
  fi
  [ ! -f "$LOCAL_VARS" ] || { migrate_local_vars; inv+=(-i "$LOCAL_VARS"); }
}
host_vars() { ansible-inventory "${inv[@]}" --host "$host" 2> /dev/null || true; }

# git needs a name and an email; ask once and keep them (bootstrap.sh --name / --email do the same)
# a git name / email nothing has given yet: asked (your git config is the suggestion, Enter takes it); without a
# terminal, or with DOTFILES_YES=true, the git config value is taken as it is
ask_name_email() {
  local vars value suggestion key env_var label lines=()
  vars="$(host_vars)"
  # the run takes them from the vault first (private_host), then DOTFILES_NAME / DOTFILES_EMAIL, then what was typed
  # once (<key>_asked): ask only when none of these can give one
  local from_vault=false
  if [ -n "${BW_SESSION:-}${BW_PASSWORD:-}" ] || grep -q '"bitwarden": true' <<< "$vars"; then from_vault=true; fi
  for key in git_name git_email; do
    if [ "$key" = git_name ]; then env_var="${DOTFILES_NAME:-}"; else env_var="${DOTFILES_EMAIL:-}"; fi
    if [ "$from_vault" = true ] || [ -n "$env_var" ]; then continue; fi
    grep -q "\"${key}_asked\": \"[^\"]" <<< "$vars" && continue
    # a value of its own in host_vars (not the template in group_vars)
    grep -qE "\"$key\": \"[^\"{]" <<< "$vars" && continue
    if [ "$key" = git_name ]; then label="Your name, for git commits"; suggestion="$(git config --global user.name || true)"
    else label="Your email, for git commits"; suggestion="$(git config --global user.email || true)"
    fi
    value=""
    if has_tty && [ "${DOTFILES_YES:-}" != true ]; then
      while [ -z "$value" ]; do
        read -r -p "$label${suggestion:+ [$suggestion]}: " value < /dev/tty || break
        value="${value:-$suggestion}"
      done
    else
      value="$suggestion"
    fi
    [ -z "$value" ] || lines+=("${key}_asked: $(yaml_str "$value")")
  done
  [ ${#lines[@]} -eq 0 ] && return 0
  remember "${lines[@]}"
  say "kept in $LOCAL_VARS"
  case " ${inv[*]} " in *" $LOCAL_VARS "*) ;; *) inv+=(-i "$LOCAL_VARS") ;; esac
}

# bitwarden: true for this machine: the playbook reads secrets from the vault, which has to be unlocked
bitwarden_unlock() {
  [ -z "${BW_SESSION:-}" ] || return 0
  case " $* " in *bitwarden=false*) return 0 ;; esac
  local secret="$REPO/home/.local/bin/dotfiles-secret" session
  # on when this machine says so, or when bootstrap.sh kept a Bitwarden login in the Keychain / Secret Service
  grep -q '"bitwarden": true' <<< "$(host_vars)" || "$secret" get BW_PASSWORD > /dev/null 2>&1 || return 0
  command -v bw > /dev/null 2>&1 || die "bitwarden is on for $host but bw is not installed (once without it: dot apply -e bitwarden=false)"
  if session="$("$secret" bw-session 2> /dev/null)" && [ -n "$session" ]; then
    export BW_SESSION="$session"
    say "Bitwarden unlocked with the login kept by bootstrap.sh"
    return 0
  fi
  case "$(bw status 2> /dev/null)" in
    *'"status":"unauthenticated"'*) die "bitwarden is on for $host: log in first (bw login, see docs/bitwarden.md)" ;;
  esac
  say "Unlocking Bitwarden (secrets for the dotfiles)"
  if [ -n "${BW_PASSWORD:-}" ]; then
    BW_SESSION="$(bw unlock --passwordenv BW_PASSWORD --raw)" || die "could not unlock Bitwarden"
  else
    has_tty || die "Bitwarden is locked and there is no terminal to ask for the password: set BW_SESSION or BW_PASSWORD"
    BW_SESSION="$(bw unlock --raw < /dev/tty)" || die "could not unlock Bitwarden"
  fi
  export BW_SESSION
}

playbook() {
  inventory
  bitwarden_unlock "$@"   # first: with the vault open, the name and email come from it and are not asked
  ask_name_email
  # dotfiles_update=false: apply the checkout as it is (dot sync pulls first)
  local args=("${inv[@]}" -c local -e "dotfiles_dir=$REPO" -e dotfiles_update=false)
  sudo_for_run
  # sudo for the steps that need it: the password from the environment, else Ansible asks once if it can't use an
  # already unlocked sudo
  local pwfile
  if [ "$(id -u)" -ne 0 ] && pwfile="$(become_password_file "$TMP")"; then
    args+=(--become-password-file "$pwfile")
  elif [ "$(id -u)" -ne 0 ] && ! ansible all -i localhost, -c local -b -m ansible.builtin.command -a true > /dev/null 2>&1 < /dev/null; then
    args+=(--ask-become-pass)
  fi
  say "ansible-playbook site.yml for $host${group:+ ($group)} $*"
  ansible-playbook "${args[@]}" -l "$host" "$@" site.yml
}

cmd="${1:-apply}"
[ $# -eq 0 ] || shift
case "$cmd" in
  apply) playbook "$@" ;;
  sync)
    say "git pull in $REPO"
    git -C "$REPO" pull --ff-only || die "could not fast-forward $REPO: commit or stash your changes (dot status), then dot sync again"
    playbook "$@"
    ;;
  check) playbook --check --diff "$@" ;;
  save)
    msg="${*:-Update from $host}"
    if [ -z "$(git -C "$REPO" status --porcelain)" ]; then
      say "nothing changed in $REPO"
    else
      git -C "$REPO" add -A
      git -C "$REPO" commit -q -m "$msg"
      say "committed: $msg"
    fi
    git -C "$REPO" push --quiet || die "push failed: dot sync first if another machine pushed, then dot save again"
    say "pushed; on the other machines: dot sync"
    ;;
  status)
    printf 'machine: %s%s\nrepo:    %s (%s)\n' "$host" "${group:+ (group $group)}" "$REPO" "$(git -C "$REPO" rev-parse --abbrev-ref HEAD)"
    if [ -f "$LOCAL_VARS" ]; then
      printf 'choices: %s\n' "$LOCAL_VARS"
      grep -E '^      [a-z_]+: ' "$LOCAL_VARS" | sed 's/^      /  /' || true
    fi
    printf '\n'
    git -C "$REPO" status --short --branch
    ;;
  remember)
    if [ $# -gt 0 ]; then
      for line in "$@"; do
        [[ "$line" =~ ^[a-z_]+:\ .+ ]] || die "dot remember 'KEY: VALUE' (got: $line)"
      done
      remember "$@"
      say "kept in $LOCAL_VARS"
    else
      inventory
      ask_name_email
    fi
    ;;
  audit) python3 "$REPO/scripts/check-install.py" "$@" ;;
  cd) printf '%s\n' "$REPO" ;;
  *) die "unknown command: $cmd (dot help)" ;;
esac
