#!/usr/bin/env bash
# dotfiles-secret: values kept in the OS secret store, not in a file: the macOS Keychain (security), or the Secret
# Service on Linux (secret-tool, from libsecret-tools). Everything is under the service name "dotfiles".
#
#   dotfiles-secret get NAME        print it (exit 1 if there is none)
#   dotfiles-secret set NAME        store the value read from stdin (never on a command line)
#   dotfiles-secret delete NAME
#   dotfiles-secret bw-session      log in to Bitwarden if needed (BW_CLIENTID / BW_CLIENTSECRET), unlock it with
#                                   BW_PASSWORD, print the session key: export BW_SESSION="$(dotfiles-secret bw-session)"
#
# bootstrap.sh keeps BW_CLIENTID, BW_CLIENTSECRET and BW_PASSWORD here after the first setup, so `bw` in a shell,
# `dot` and the playbook unlock the vault by themselves. A variable already in the environment wins over the store.
set -euo pipefail

SERVICE=dotfiles

store() {
  if [ "$(uname -s)" = Darwin ]; then echo keychain
  elif command -v secret-tool > /dev/null 2>&1 && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then echo secret-service
  else echo none
  fi
}

get() {
  case "$(store)" in
    keychain) security find-generic-password -s "$SERVICE" -a "$1" -w 2> /dev/null ;;
    secret-service) secret-tool lookup service "$SERVICE" account "$1" 2> /dev/null ;;
    *) return 1 ;;
  esac
}

set_value() {
  local value
  value="$(cat)"
  [ -n "$value" ] || { echo "dotfiles-secret: empty value for $1, not stored" >&2; return 1; }
  case "$(store)" in
    keychain)
      # through security's own prompt-less shell (-i), so the value is not on a command line other processes can see
      local quoted="${value//\\/\\\\}"
      quoted="${quoted//\"/\\\"}"
      printf 'add-generic-password -U -s "%s" -a "%s" -l "dotfiles: %s" -w "%s"\n' "$SERVICE" "$1" "$1" "$quoted" \
        | security -i > /dev/null
      ;;
    secret-service) printf '%s' "$value" | secret-tool store --label="dotfiles: $1" service "$SERVICE" account "$1" ;;
    *) echo "dotfiles-secret: no secret store here (macOS Keychain, or secret-tool on Linux)" >&2; return 1 ;;
  esac
}

delete() {
  case "$(store)" in
    keychain) security delete-generic-password -s "$SERVICE" -a "$1" > /dev/null 2>&1 || true ;;
    secret-service) secret-tool clear service "$SERVICE" account "$1" 2> /dev/null || true ;;
  esac
}

value_of() {
  local v="${!1:-}"
  if [ -n "$v" ]; then printf '%s' "$v"; else get "$1"; fi
}

bw_session() {
  command -v bw > /dev/null 2>&1 || { echo "dotfiles-secret: bw is not installed" >&2; return 1; }
  local status id secret password
  status="$(bw status 2> /dev/null | sed -n 's/.*"status":"\([a-z]*\)".*/\1/p')"
  if [ "$status" = unauthenticated ]; then
    id="$(value_of BW_CLIENTID)" || true
    secret="$(value_of BW_CLIENTSECRET)" || true
    [ -n "$id" ] && [ -n "$secret" ] || { echo "dotfiles-secret: Bitwarden is logged out and no API key is kept" >&2; return 1; }
    BW_CLIENTID="$id" BW_CLIENTSECRET="$secret" bw login --apikey > /dev/null
  fi
  password="$(value_of BW_PASSWORD)" || { echo "dotfiles-secret: no master password kept (BW_PASSWORD)" >&2; return 1; }
  BW_PASSWORD="$password" bw unlock --passwordenv BW_PASSWORD --raw
}

case "${1:-}" in
  get) [ $# -eq 2 ] || exit 2; get "$2" ;;
  set) [ $# -eq 2 ] || exit 2; set_value "$2" ;;
  delete) [ $# -eq 2 ] || exit 2; delete "$2" ;;
  bw-session) bw_session ;;
  store) store ;;
  *) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
