[user]
	name = Rehan Ali
	email = {{ .email | quote }}
	signingKey =
[core]
	excludesfile = {{ .chezmoi.homeDir }}/.gitignore_global
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path =
[mergetool "sourcetree"]
	cmd = ~/Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[commit]
	template = {{ .chezmoi.homeDir }}/.stCommitMsg
	gpgSign = false
[init]
	defaultBranch = main
[tag]
	forceSignAnnotated = false
[gpg]
	format = openpgp
	program = gpg
[gpg "ssh"]
	program =
	allowedSignersFile =

# delta is optional: Intel Macs have neither a mise build nor a Homebrew bottle for it. These run
# through the shell, so git falls back to its normal pager when delta is not installed.
[core]
    pager = "if command -v delta >/dev/null 2>&1; then delta; else ${PAGER:-less}; fi"

[interactive]
    diffFilter = "if command -v delta >/dev/null 2>&1; then delta --color-only; else cat; fi"

[delta]
    navigate = true    # use n and N to move between diff sections
    side-by-side = true
    line-numbers = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default
