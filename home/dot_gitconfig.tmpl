{{- $name := (index . "name") | default "" -}}
{{- if not $name -}}{{ fail "no name for git: run `chezmoi init` again, it asks for it (or set DOTFILES_NAME)" }}{{- end -}}
{{- $git := .settings.git -}}
[user]
	name = {{ $name | quote }}
	email = {{ .email | quote }}
	signingKey = {{ $git.signing_key }}
[core]
	excludesfile = {{ .chezmoi.homeDir }}/.gitignore_global
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path =
[mergetool "sourcetree"]
	cmd = ~/Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[commit]
{{- if $git.commit_template }}
	template = {{ $git.commit_template }}
{{- end }}
	gpgSign = {{ $git.sign_commits }}
[init]
	defaultBranch = {{ $git.default_branch }}
[tag]
	forceSignAnnotated = false
[gpg]
	format = {{ $git.signing_format }}
	program = {{ $git.gpg_program }}
[gpg "ssh"]
	program =
	allowedSignersFile =

# delta is not available everywhere (no Intel Mac build), so fall back to the normal pager without it
[core]
    pager = "if command -v delta >/dev/null 2>&1; then delta; else ${PAGER:-less}; fi"

[interactive]
    diffFilter = "if command -v delta >/dev/null 2>&1; then delta --color-only; else cat; fi"

[delta]
    navigate = true    # use n and N to move between diff sections
    side-by-side = true
    line-numbers = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default
