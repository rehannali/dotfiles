# Written by Ansible (roles/mise) from inventory/group_vars/all/packages.yml. Edit that, not this file.
# Override per project with a mise.toml in that repo.
[tools]

# Language runtimes: every machine. Replaces pyenv, rbenv, rvm, sdkman and brew-installed languages.
{% for name, version in selected.runtimes.items() %}
{{ name | to_json }} = {{ version | to_json }}
{% endfor %}
{% if selected.gems and dotfiles_os == 'darwin' and gui_apps | bool and 'ruby' in selected.runtimes %}

# Ruby gems (macOS, Apple development), installed by mise with its Ruby
{% for gem in selected.gems %}
{{ ('gem:' ~ gem) | to_json }} = "latest"
{% endfor %}
{% endif %}
{% if tool_plan.mise %}

# CLI tools: Linux, and on Intel Macs the ones without a MacPorts port (dev tooling such as pipx, poetry, zig, fvm).
{% for id in tool_plan.mise | reject('in', remove.mise | default([])) %}
{{ id | to_json }} = "latest"
{% endfor %}
{% endif %}
{% if intel_mise_fallback | default([]) %}

# Intel Mac: the port did not install, its mise_fallback instead (packages.yml)
{% for id in intel_mise_fallback %}
{{ id | to_json }} = "latest"
{% endfor %}
{% endif %}
