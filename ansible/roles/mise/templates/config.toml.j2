# Written by Ansible (roles/mise) from inventory/group_vars/all/packages.yml. Edit that, not this file.
# Override per project with a mise.toml in that repo.
[tools]

# Language runtimes: every machine. Replaces pyenv, rbenv, rvm, sdkman and brew-installed languages.
{% for name, version in packages.runtimes.items() %}
{{ name | to_json }} = {{ version | to_json }}
{% endfor %}
{% if tool_plan.mise %}

# CLI tools: only where Homebrew is not the source (Intel Macs and Linux).
{% for id in tool_plan.mise | reject('in', remove.mise | default([])) %}
{{ id | to_json }} = "latest"
{% endfor %}
{% endif %}
{% if intel_mise_fallback | default([]) %}

# Intel Mac: neither a Homebrew bottle nor MacPorts could install these (mise_fallback in packages.yml)
{% for id in intel_mise_fallback %}
{{ id | to_json }} = "latest"
{% endfor %}
{% endif %}
