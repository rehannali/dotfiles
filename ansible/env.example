# Environment variables without Bitwarden: copy to ~/.config/dotfiles/env (mode 600: chmod 600), fill in, run
# `dot apply`. Every NAME=value here ends up exported in ~/.config/dotfiles/secrets.zsh, which ~/.zshenv and
# ~/.bashrc load, so every shell has it. A Bitwarden field of the same name wins (docs/bitwarden.md).
#
# One NAME=value per line; `export ` in front and quotes around the value are fine. Lines starting with # are ignored.

# git, for commits (else asked once)
DOTFILES_NAME="Your Name"
DOTFILES_EMAIL=you@example.com

# tokens: exported as they are
GITHUB_TOKEN=
# NPM_TOKEN=
# OPENAI_API_KEY=

# Xcode's Apple ID (xcodes), and piserver's secrets (only read by the run, not exported)
# XCODES_USERNAME=you@example.com
# XCODES_PASSWORD=
# SERVER_CLOUDFLARED_TOKEN=
# SERVER_NETBIRD_SETUP_KEY=
# SERVER_NEXTDNS_PROFILE=
# SERVER_SAMBA_PASSWORD=
